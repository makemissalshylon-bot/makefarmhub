{
  "name": "makefarmhub",
  "private": true,
  "version": "1.0.2",
  "description": "MAKEFARMHUB - Digital Agriculture Marketplace connecting farmers, buyers, and transporters in Zimbabwe",
  "author": {
    "name": "Missal S Make",
    "email": "missal@makefarmhub.com"
  },
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:integration": "vitest run tests/integration",
    "test:all": "npm run test && npm run test:e2e",
    "test:perf:load": "k6 run tests/performance/k6/load-test.js",
    "test:perf:stress": "k6 run tests/performance/k6/stress-test.js",
    "test:perf:spike": "k6 run tests/performance/k6/spike-test.js",
    "test:perf:payment": "k6 run tests/performance/k6/payment-api-test.js",
    "test:lighthouse": "lhci autorun",
    "test:security:headers": "k6 run tests/security/header-check.js",
    "test:security:injection": "k6 run tests/security/input-validation-test.js",
    "audit": "npm audit --audit-level=high",
    "perf:report": "node scripts/performance-report.js",
    "optimize:images": "node scripts/optimize-images.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vercel/node": "^5.5.33",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^28.0.0",
    "netlify-cli": "^23.12.3",
    "playwright": "^1.58.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-compression2": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "@sentry/react": "^8.0.0",
    "@stripe/stripe-js": "^2.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "africastalking": "^0.6.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "speakeasy": "^2.0.0",
    "stripe": "^14.5.0"
  }
}
