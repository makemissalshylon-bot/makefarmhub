# =============================================
# MAKEFARMHUB Environment Variables
# =============================================

# =============================================
# SUPABASE CONFIGURATION (Required for real database)
# =============================================

# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (NEVER expose in frontend! Add to Vercel env vars only)
# Required for webhook handlers and admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================
# ADMIN CREDENTIALS (DEV ONLY)
# =============================================
# Client-bundled — NEVER rely on these in production.
# Production admin access must use a Supabase profile with role=admin.
# Dev shortcut email (local only)
VITE_ADMIN_EMAIL=missal@makefarmhub.com

# Dev-only admin password. Ignored in production builds.
VITE_ADMIN_PASSWORD=

# Google Analytics Measurement ID
# Get from: https://analytics.google.com/
VITE_GA_ID=G-XXXXXXXXXX

# =============================================
# STRIPE CONFIGURATION (Required for real payments)
# =============================================

# Frontend: Stripe Publishable Key (safe to expose)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Backend: Stripe Secret Key (NEVER expose in frontend!)
# Add this to Vercel Environment Variables only
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Backend: Stripe Webhook Secret (for payment confirmations)
# Get from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =============================================
# MOBILE MONEY CONFIGURATION (Required for mobile payments)
# =============================================

# EcoCash API Key (add to Vercel env vars only)
# ECOCASH_API_KEY=your_ecocash_api_key_here

# OneMoney API Key (add to Vercel env vars only)
# ONEMONEY_API_KEY=your_onemoney_api_key_here

# InnBucks API Key (add to Vercel env vars only)
# INNBUCKS_API_KEY=your_innbucks_api_key_here

# Telecash API Key (add to Vercel env vars only)
# TELECASH_API_KEY=your_telecash_api_key_here

# =============================================
# EMAIL SERVICE CONFIGURATION
# =============================================

# SendGrid API Key (add to Vercel env vars only)
# Get from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SendGrid Verified Sender Email (must be verified in SendGrid)
# SENDGRID_FROM_EMAIL=your_verified_email@example.com

# SendGrid Sender Name (shown in the From field)
# SENDGRID_FROM_NAME=MakeFarmHub

# OTP Secret Key for signing OTP tokens (add to Vercel env vars only)
# Generate a random string: openssl rand -hex 32
# OTP_SECRET=your_random_secret_key_here

# =============================================
# SMS SERVICE CONFIGURATION (Africa's Talking - for phone OTP)
# =============================================

# Africa's Talking API Key (add to Vercel env vars only)
# Get from: https://account.africastalking.com/apps/sandbox/settings/key
# AFRICASTALKING_API_KEY=your_africastalking_api_key_here

# Africa's Talking Username (add to Vercel env vars only)
# Use 'sandbox' for testing or your production username
# Get from: https://account.africastalking.com/apps
# AFRICASTALKING_USERNAME=sandbox

# =============================================
# MONITORING & ANALYTICS
# =============================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Alias accepted by code (same as VITE_GA_ID)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================
# WEATHER SERVICE
# =============================================

# OpenWeatherMap API Key for weather data
# Get from: https://openweathermap.org/api
# Alias VITE_WEATHER_API_KEY also accepted
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# =============================================
# REAL-TIME / WEBSOCKET CONFIGURATION
# =============================================

# WebSocket URL for real-time messaging (optional)
# Leave empty to use Supabase Realtime
VITE_WS_URL=

# =============================================
# API Configuration
# =============================================

# API URL for serverless functions (auto-configured on Vercel)
# For local dev, leave empty to use /api
VITE_API_URL=

# App URL (used in emails and webhooks)
VITE_APP_URL=https://makefarmhub-eosin.vercel.app
